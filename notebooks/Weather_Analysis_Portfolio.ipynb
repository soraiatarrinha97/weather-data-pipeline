   "source": [
    "selected_cities = [c for c in [\"Tomar\", \"Coimbra\", \"Braga\", \"Lisboa\", \"Peniche\", \"Viseu\"] if c in dataframe[\"City\"].values]\n",
    "humidity_by_day = daily.loc[daily[\"City\"].isin(selected_cities)].groupby([\"Date\", \"City\"])[\"humidity\"].mean().unstack(\"City\")\n",
    "ax = humidity_by_day.plot(figsize=(11, 4), marker=\"o\")\n",
    "ax.set(title=\"Daily mean humidity — selected cities\", xlabel=\"Date\", ylabel=\"Humidity (%)\")\n",
    "ax.grid(alpha=0.25)\n",
    "plt.xticks(rotation=30)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f7ce50bf",
   "metadata": {},
   "source": [
    "## Correlation of daily maximum temperatures\n",
    "\n",
    "    Correlations require multiple independent days. A single pipeline run is not enough."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "1eda39cf",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-11-05T15:17:06.854095Z",
     "iopub.status.busy": "2026-11-05T15:17:06.853946Z",
     "iopub.status.idle": "2026-11-05T15:17:07.085394Z",
     "shell.execute_reply": "2026-11-05T15:17:07.084578Z"
    }
   },
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1000x800 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "max_by_day = daily.groupby([\"Date\", \"City\"])[\"temp\"].max().unstack(\"City\")\n",
    "if len(max_by_day) < 3:\n",
    "    print(\"Not enough days for a meaningful correlation matrix. Choose DATA_SOURCE='sample' for historical trends.\")\n",
    "else:\n",
    "    corr = max_by_day.corr(min_periods=3)\n",
    "    fig, ax = plt.subplots(figsize=(10, 8))\n",
    "    heat = ax.imshow(corr.values, vmin=-1, vmax=1, cmap=\"coolwarm\")\n",
    "    ax.set_xticks(range(len(corr.columns)), corr.columns, rotation=90)\n",
    "    ax.set_yticks(range(len(corr.index)), corr.index)\n",
    "    ax.set_title(\"Correlation — daily maximum temperature\")\n",
    "    fig.colorbar(heat, ax=ax)\n",
    "    plt.tight_layout()\n",
    "    plt.show()"
   ]
  },
