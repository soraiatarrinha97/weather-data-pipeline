    "from pathlib import Path\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import folium\n",
    "from IPython.display import display\n",
    "\n",
    "def find_root():\n",
    "    cwd = Path.cwd().resolve()\n",
    "    for p in (cwd, *cwd.parents):\n",
    "        if (p / \"sample_data\" / \"historic_weather_2021_2022.csv\").exists():\n",
    "            return p\n",
    "    raise FileNotFoundError(\"Cannot find project root. Open the repository in VS Code and run the notebook from there.\")\n",
    "\n",
    "ROOT = find_root()\n",
    "print(\"Project root:\", ROOT)\n",
    "print(\"pandas:\", pd.__version__, \"| folium:\", folium.__version__)"
   ]
