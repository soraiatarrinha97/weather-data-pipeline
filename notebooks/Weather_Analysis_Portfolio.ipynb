   "source": [
    "daily = dataframe.assign(Date=dataframe[\"Timestamp_dt\"].dt.date)\n",
    "daily_temps = daily.groupby([\"Date\", \"City\"], as_index=False)[\"temp\"].mean()\n",
    "pivot = daily_temps.pivot(index=\"Date\", columns=\"City\", values=\"temp\")\n",
    "ax = pivot.plot(figsize=(12, 5), marker=\"o\" if len(pivot) < 10 else None)\n",
    "ax.set(title=\"Daily mean temperature\", xlabel=\"Date\", ylabel=\"Temperature (°C)\")\n",
    "ax.grid(alpha=0.25)\n",
    "plt.xticks(rotation=30)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
