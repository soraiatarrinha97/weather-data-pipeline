   "source": [
    "DATA_SOURCE = \"sample\"  # \"sample\" or \"runs\"\n",
    "\n",
    "def load_weather_data(source: str) -> pd.DataFrame:\n",
    "    if source == \"sample\":\n",
    "        df = pd.read_csv(ROOT / \"sample_data\" / \"historic_weather_2021_2022.csv\")\n",
    "        df = df.rename(columns={\"Distance\": \"distance_to_ref_km\"})\n",
    "        df[\"Timestamp_dt\"] = pd.to_datetime(df[\"Timestamp\"], format=\"%d-%m-%Y %H:%M:%S\")\n",
    "        return df\n",
    "    if source != \"runs\":\n",
    "        raise ValueError(\"DATA_SOURCE must be 'sample' or 'runs'.\")\n",
    "    files = sorted((ROOT / \"data\" / \"runs\").glob(\"*_weather.csv\"))\n",
    "    if not files:\n",
    "        raise FileNotFoundError(\"No run CSVs. First run: python -m scripts.run_pipeline --ref-city Peniche --cities Tomar Coimbra Braga --out-dir data/runs\")\n",
    "    all_runs = []\n",
    "    for f in files:\n",
    "        part = pd.read_csv(f)\n",
    "        if \"collected_at_utc\" in part.columns:\n",
    "            part[\"Timestamp_dt\"] = pd.to_datetime(part[\"collected_at_utc\"], utc=True, errors=\"coerce\").dt.tz_localize(None)\n",
    "        else:\n",
    "            stamp = f.stem.replace(\"_weather\", \"\")\n",
    "            # Compatible with older repository snapshots.\n",
    "            stamp = \"_\".join(stamp.split(\"_\")[:2])\n",
    "            part[\"Timestamp_dt\"] = pd.to_datetime(stamp, format=\"%Y-%m-%d_%H-%M-%S\", errors=\"coerce\")\n",
    "        all_runs.append(part)\n",
    "    df = pd.concat(all_runs, ignore_index=True)\n",
    "    return df.rename(columns={\"city\": \"City\", \"temp_c\": \"temp\", \"weather_desc\": \"description\"})\n",
    "\n",
    "dataframe = load_weather_data(DATA_SOURCE)\n",
    "dataframe[\"temp\"] = pd.to_numeric(dataframe[\"temp\"], errors=\"coerce\")\n",
    "dataframe[\"humidity\"] = pd.to_numeric(dataframe[\"humidity\"], errors=\"coerce\")\n",
    "dataframe = dataframe.dropna(subset=[\"City\", \"Timestamp_dt\", \"temp\"]).sort_values(\"Timestamp_dt\").reset_index(drop=True)\n",
    "print(f\"{len(dataframe):,} observations | {dataframe['City'].nunique()} cities | {dataframe['Timestamp_dt'].min()} → {dataframe['Timestamp_dt'].max()}\")\n",
    "display(dataframe.head())"
   ]
  },
