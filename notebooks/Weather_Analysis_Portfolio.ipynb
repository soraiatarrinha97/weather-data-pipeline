    "APPROX_CITY_COORDS = {\n",
    "    \"Peniche\": (39.36, -9.38), \"Tomar\": (39.60, -8.41),\n",
    "    \"Coimbra\": (40.21, -8.43), \"Braga\": (41.55, -8.43),\n",
    "    \"Castelo Branco\": (39.82, -7.49), \"Beja\": (38.02, -7.86),\n",
    "    \"Sabugal\": (40.35, -7.09), \"Lisboa\": (38.72, -9.14),\n",
    "    \"Viseu\": (40.66, -7.91), \"Aljustrel\": (37.88, -8.16),\n",
    "    \"Leiria\": (39.74, -8.81),\n",
    "}\n",
    "city_coords = dataframe[[\"City\"]].drop_duplicates().copy()\n",
    "if {\"lat\", \"lon\"}.issubset(dataframe.columns):\n",
    "    city_coords = dataframe[[\"City\", \"lat\", \"lon\"]].dropna().drop_duplicates(subset=[\"City\"])\n",
    "else:\n",
    "    city_coords[\"lat\"] = city_coords[\"City\"].map(lambda c: APPROX_CITY_COORDS.get(c, (None, None))[0])\n",
    "    city_coords[\"lon\"] = city_coords[\"City\"].map(lambda c: APPROX_CITY_COORDS.get(c, (None, None))[1])\n",
    "city_coords = city_coords.dropna(subset=[\"lat\", \"lon\"])\n",
    "portugal_map = folium.Map(location=[39.6, -8.0], zoom_start=6)\n",
    "for row in city_coords.itertuples(index=False):\n",
    "    folium.Marker([row.lat, row.lon], tooltip=row.City).add_to(portugal_map)\n",
    "display(portugal_map)"
   ]
